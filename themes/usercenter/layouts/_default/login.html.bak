{{ partial "header.html" . }}

<body>
    <div class="bg-layer"></div>

    <nav class="navbar">
        <div class="nav-left">
            <button id="menu-btn" class="icon-btn nav-icon-btn mobile-only">
                <span class="material-icons-round">menu</span>
            </button>
            <p class="brand-logo">{{ T "brand_name" | default "Ezer账号" }}</p>
        </div>

        <div class="nav-right desktop-only">
            <a href="{{ "/terms-of-service/" | relLangURL }}" class="nav-link">{{ T "terms_of_service" | default "服务协议" }}</a>
            <a href="{{ "/privacy-policy/" | relLangURL }}" class="nav-link">{{ T "privacy_policy" | default "隐私政策" }}</a>
        </div>

        <div class="nav-right">
            <button id="theme-toggle" class="icon-btn nav-icon-btn">
                <span class="material-icons-round">dark_mode</span>
            </button>
            {{ $zhURL := replace .RelPermalink "/en" "" | default "/" }}
            {{ $enURL := "" }}
            {{ if eq $zhURL "/" }}
            {{ $enURL = "/en/" }}
            {{ else }}
            {{ $enURL = printf "/en%s" $zhURL }}
            {{ end }}
            <div class="nav-dropdown" onclick="this.classList.toggle('active')">
                <button class="icon-btn nav-icon-btn dropdown-toggle">
                    <span class="material-icons-round">language</span>
                </button>
                <div class="dropdown-menu">
                    <a href="{{ $zhURL }}" class="dropdown-item {{ if eq .Site.Language.Lang "zh" }}active{{ end }}">简体中文</a>
                    <a href="{{ $enURL }}" class="dropdown-item {{ if eq .Site.Language.Lang "en" }}active{{ end }}">English</a>
                </div>
            </div>
        </div>
    </nav>
    <script type="text/javascript">
        // 保持语言切换时的查询参数 (如 redirect)
        document.querySelectorAll('.dropdown-menu .dropdown-item').forEach(link => {
            if (window.location.search) {
                const url = new URL(link.href, window.location.origin);
                url.search = window.location.search;
                link.href = url.toString();
            }
        });
    </script>

    <div class="sidebar-overlay" id="sidebar-overlay"></div>
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <span class="brand-logo">Ezer</span>
            <button id="close-sidebar" class="icon-btn">
                <span class="material-icons-round">close</span>
            </button>
        </div>
        <div class="sidebar-menu">
            <a href="{{ "/terms-of-service/" | relLangURL }}" class="sidebar-item">{{ T "terms_of_service" | default "服务协议" }}</a>
            <a href="{{ "/privacy-policy/" | relLangURL }}" class="sidebar-item">{{ T "privacy_policy" | default "隐私政策" }}</a>
        </div>
    </aside>

    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-header">
                <h2 id="auth-title">{{ T "login_title" }}</h2>
                <p id="auth-subtitle">{{ T "use_ezer_account" }}</p>
            </div>

            <div id="step-email" class="auth-step active">
                <div class="input-group">
                    <input type="email" id="input-email" required placeholder=" ">
                    <label for="input-email">{{ T "email_label" }}</label>
                </div>
                <div class="actions-right">
                    <button class="btn-text" id="btn-to-register">{{ T "create_account_btn" }}</button>
                    <button class="btn-primary" id="btn-next">{{ T "next_btn" }}</button>
                </div>

                <div class="divider"><span>{{ T "social_login_divider" }}</span></div>

                <div class="social-login">
                    <button class="social-btn" data-provider="google" title="{{ T "google_login_title" }}">
                        <i class="fa-brands fa-google"></i>
                    </button>
                    <button class="social-btn" data-provider="github" title="{{ T "github_login_title" }}">
                        <i class="fa-brands fa-github"></i>
                    </button>
                </div>
            </div>

            <div id="step-password" class="auth-step">
                <div class="user-chip" id="user-chip">
                    <span class="material-icons-round">account_circle</span>
                    <span id="display-email"></span>
                </div>
                <div class="input-group">
                    <input type="password" id="input-password" required placeholder=" ">
                    <label for="input-password">{{ T "input_password_label" }}</label>
                </div>
                <div class="actions-left-right">
                    <button class="btn-text" id="btn-forgot-pwd">{{ T "forgot_password_btn" }}</button>
                </div>
                <div class="actions-right mt-4">
                    <button class="btn-text" id="btn-back-email">{{ T "back_btn" }}</button>
                    <button class="btn-outlined" id="btn-otp-login">{{ T "send_otp_btn" }}</button>
                    <button class="btn-primary" id="btn-login">{{ T "login_btn" }}</button>
                </div>
            </div>

            <div id="step-otp" class="auth-step">
                <div class="user-chip" id="otp-user-chip">
                    <span class="material-icons-round">account_circle</span>
                    <span id="display-otp-email"></span>
                </div>
                <div class="otp-message" style="margin-bottom: 24px; font-size: 14px; color: var(--text-color); text-align: center;">
                    {{ T "otp_message_hint" }}
                </div>
                <div class="otp-inputs-container">
                    <input type="text" maxlength="1" class="otp-input" data-index="0" inputmode="numeric" pattern="[0-9]*" autocomplete="one-time-code">
                    <input type="text" maxlength="1" class="otp-input" data-index="1" inputmode="numeric" pattern="[0-9]*">
                    <input type="text" maxlength="1" class="otp-input" data-index="2" inputmode="numeric" pattern="[0-9]*">
                    <input type="text" maxlength="1" class="otp-input" data-index="3" inputmode="numeric" pattern="[0-9]*">
                    <input type="text" maxlength="1" class="otp-input" data-index="4" inputmode="numeric" pattern="[0-9]*">
                    <input type="text" maxlength="1" class="otp-input" data-index="5" inputmode="numeric" pattern="[0-9]*">
                </div>
                <div class="otp-actions-row">
                    <button class="btn-text" id="btn-otp-resend" disabled>{{ T "otp_resend" }} (60s)</button>
                </div>
                <div class="actions-right mt-4">
                    <button class="btn-text" id="btn-back-otp">{{ T "back_btn" }}</button>
                    <button class="btn-primary" id="btn-verify-otp">{{ T "verify_and_login_btn" }}</button>
                </div>
            </div>

            <div id="step-register" class="auth-step">
                <div class="input-group">
                    <input type="email" id="reg-email" required placeholder=" ">
                    <label for="reg-email">{{ T "email_label" }}</label>
                </div>
                <div class="input-group">
                    <input type="password" id="reg-password" required placeholder=" ">
                    <label for="reg-password">{{ T "set_password_label" }}</label>
                </div>
                <div class="input-group">
                    <input type="password" id="reg-password-repeat" required placeholder=" ">
                    <label for="reg-password-repeat">{{ T "confirm_password_label" }}</label>
                </div>
                <div style="margin-top: 0; margin-bottom: 20px; font-size: 12px;">{{ T "password_hint" }}</div>
                <div class="input-group">
                    <input type="text" id="reg-invite-code" placeholder=" ">
                    <label for="reg-invite-code">{{ T "invitation_code_label" }}</label>
                </div>
                <div class="actions-right mt-4">
                    <button class="btn-text" id="btn-back-login">{{ T "already_have_account_btn" }}</button>
                    <button class="btn-primary" id="btn-register">{{ T "register_btn" }}</button>
                </div>
            </div>

            <div id="step-register-success" class="auth-step">
                <div class="success-message" style="line-height: 1.6; margin-bottom: 24px; font-size: 14px; color: var(--text-color);">
                    {{ T "register_success_message" | safeHTML }}
                    <div style="margin-top: 12px; font-size: 12px; color: var(--text-secondary); opacity: 0.8;">
                        {{ T "junk_mail_hint" }}
                    </div>
                </div>
                <div class="actions-right mt-4">
                    <button class="btn-primary" id="btn-success-login" style="width: 100%; text-align: center; border-radius: 20px;">{{ T "activated_go_login_btn" }}</button>
                </div>
            </div>

            <div id="step-forgot" class="auth-step">
                <div class="input-group">
                    <input type="email" id="forgot-email" required placeholder=" ">
                    <label for="forgot-email">{{ T "email_label" }}</label>
                </div>

                <div class="actions-right mt-4">
                    <button class="btn-text" id="btn-cancel-forgot">{{ T "back_to_login_btn" }}</button>
                    <button class="btn-primary" id="btn-send-reset-link">{{ T "send_reset_link_btn" }}</button>
                </div>
            </div>

            <div id="step-update-password" class="auth-step">
                <div class="input-group">
                    <input type="password" id="new-password" required placeholder=" ">
                    <label for="new-password">{{ T "new_password_label" }}</label>
                </div>
                <div class="input-group">
                    <input type="password" id="new-password-confirm" required placeholder=" ">
                    <label for="new-password-confirm">{{ T "confirm_new_password_label" }}</label>
                </div>
                <div style="margin-top: 0; margin-bottom: 20px; font-size: 12px;">{{ T "password_hint" }}</div>
                <div class="actions-right mt-4">
                    <button class="btn-primary" id="btn-save-new-password">{{ T "save_password_btn" }}</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        window.i18n = {
            title_email: '{{ T "login_title" }}',
            subtitle_email: '{{ T "use_ezer_account" }}',
            title_password: '{{ T "welcome_back_title" }}',
            subtitle_password: '{{ T "enter_password_subtitle" }}',
            title_register: '{{ T "create_account_title" }}',
            subtitle_register: '{{ T "register_ezer_subtitle" }}',
            title_forgot: '{{ T "reset_password_title" }}',
            subtitle_forgot: '{{ T "find_account_subtitle" }}',
            title_update: '{{ T "reset_password_title" }}',
            subtitle_update: '{{ T "enter_new_password_subtitle" }}',
            title_register_success: '{{ T "verify_email_title" }}',
            subtitle_register_success: '{{ T "verify_email_subtitle" }}',
            please_enter_email: '{{ T "please_enter_email" }}',
            invalid_email_format: '{{ T "invalid_email_format" }}',
            login_success: '{{ T "login_success" }}',
            please_enter_password: '{{ T "please_enter_password" }}',
            login_failed: '{{ T "login_failed" }}',
            otp_sent: '{{ T "otp_sent" }}',
            password_too_short: '{{ T "password_too_short" }}',
            password_mismatch: '{{ T "password_mismatch" }}',
            registration_success: '{{ T "registration_success" }}',
            reset_email_sent: '{{ T "reset_email_sent" }}',
            updating_password: '{{ T "updating_password" }}',
            password_updated_success: '{{ T "password_updated_success" }}',
            password_update_failed: '{{ T "password_update_failed" }}',
            captcha_load_failed: '{{ T "captcha_load_failed" }}',
            captcha_failed: '{{ T "captcha_failed" }}',
            captcha_timeout: '{{ T "captcha_timeout" }}',
            security_check_title: '{{ T "security_check_title" }}',


            verification_success_set_pwd: '{{ T "verification_success_set_pwd" }}',
            recovery_interception_msg: '{{ T "recovery_interception_msg" }}',
            password_complexity_error: '{{ T "password_complexity_error" }}',
            recovery_lock_log: '{{ T "recovery_lock_log" }}',
            intercept_redirect_log: '{{ T "intercept_redirect_log" }}',
            title_otp: '{{ T "title_otp" }}',
            subtitle_otp: '{{ T "subtitle_otp" }}',
            otp_resend: '{{ T "otp_resend" }}',
            verify_and_login_btn: '{{ T "verify_and_login_btn" }}',
            please_enter_6digit_otp: '{{ T "please_enter_6digit_otp" }}',
            otp_verifying: '{{ T "otp_verifying" }}',
            otp_invalid_or_expired: '{{ T "otp_invalid_or_expired" }}',
            local_mock_otp_sent: '{{ T "local_mock_otp_sent" }}',
            local_mock_login_success: '{{ T "local_mock_login_success" }}',
            local_mock_otp_error: '{{ T "local_mock_otp_error" }}',
            redirecting_to_provider: '{{ T "redirecting_to_provider" }}'
        };
    </script>
    <script src="{{ "js/common.js" | relURL }}?v=8"></script>
    <script src="{{ "js/login.js" | relURL }}?v=10"></script>
</body>

</html>